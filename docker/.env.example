# xxl-job hardened deployment env. Copy to .env, fill every value, never commit .env.
# generate secrets: echo t$(openssl rand -hex 24)

# database
MYSQL_ROOT_PASSWORD=
MYSQL_USER=xxl_job
MYSQL_PASSWORD=

# admin
XXL_JOB_ADMIN_BIND=127.0.0.1
XXL_JOB_ADMIN_PORT=8080
# one-time reset of default admin password (min 12 chars); clear after first start
XXL_JOB_INIT_ADMIN_PASSWORD=

# executor token: must equal the token set on the executor group in Admin (min 32 chars, start with a letter)
XXL_JOB_EXECUTOR_TOKEN=
XXL_JOB_HANDLER_ALLOWLIST=demoJobHandler,shardingJobHandler

# network: executor registry is only accepted from this cidr
XXL_JOB_SUBNET=172.30.0.0/24
XXL_JOB_REGISTRY_ALLOWED_CIDRS=172.30.0.0/24

# detection / alerting
XXL_JOB_ALERT_WEBHOOK=
XXL_JOB_ALERT_MIN_SEVERITY=HIGH
XXL_JOB_CANARY_TOKENS=
XXL_JOB_METRICS_TOKEN=
XXL_JOB_PAYLOAD_RULES_FILE=./payload-rules.txt
